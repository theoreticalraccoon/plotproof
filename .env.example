# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: project URL and anon key. Both are public; row-level security protects the data.
# Without them the app runs as a local-only prototype.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, never expose to the browser (currently unused).
SUPABASE_SERVICE_ROLE_KEY=

# Export assistant on /sell (Gemini). Server-only. One or more keys, comma separated; load is split across them.
GEMINI_API_KEYS=

# EUDR plot statistics on /sell. Server-only; how to get one is in docs/GFW-API-KEY.md.
GFW_API_KEY=
