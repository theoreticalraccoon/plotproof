# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# NEXT_PUBLIC_SUPABASE_URL: your project URL, e.g. https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY: the anon / publishable key (sb_publishable_...).
# Both are public (they ship in the browser bundle); Row Level Security protects data.
# Without these the app runs as an anonymous prototype: sync says "on this device
# only" and /verify/<id> says verification is unavailable. Nothing is faked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS, never expose to the browser (unused for now).
SUPABASE_SERVICE_ROLE_KEY=

# --- Analysis service (optional; no in-house service ships any more) ---
# The in-house satellite service was removed (see PARKED.md); deforestation
# context now cites JRC TMF / Global Forest Watch instead. If you ever point this
# at a service speaking the lib/analysis/client.ts contract (POST /jobs,
# GET /jobs/<id>), the plot page will use it. Left empty, the app reports
# "analysis unavailable" and never invents a verdict — there is no stub fallback.
ANALYSIS_SERVICE_URL=

# --- Standing monitoring ---
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to the daily
# sweep; it also guards /api/monitoring/recheck. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production an unset value DISABLES those routes (503) rather than leaving
# them open. Only non-production builds skip the check.
CRON_SECRET=
# HMAC key for signing outgoing webhook alerts (X-PlotProof-Signature header).
ALERT_WEBHOOK_SECRET=

# --- Acoustic ingest ---
# Bearer token the LoRa gateway / network-server webhook sends to
# /api/acoustic/ingest. Same generation and same fail-closed rule as CRON_SECRET.
ACOUSTIC_INGEST_TOKEN=
