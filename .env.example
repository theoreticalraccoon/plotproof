# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# NEXT_PUBLIC_SUPABASE_URL: your project URL, e.g. https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY: the anon / publishable key (sb_publishable_...).
# Both are public (they ship in the browser bundle); Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS, never expose to the browser (unused for now).
SUPABASE_SERVICE_ROLE_KEY=

# --- Analysis service (the separate Python service in ./service, see ML.md) ---
# The real service exists (service/server.py). To use it: run it (see service/README),
# point ANALYSIS_SERVICE_URL at it, and set ANALYSIS_STUB=0. The web app already
# speaks its contract (lib/analysis/client.ts: POST /jobs, GET /jobs/<id>).
# Leave the URL empty (or ANALYSIS_STUB=1) to fall back to the built-in fake verdicts.
ANALYSIS_SERVICE_URL=
# e.g. http://localhost:8000
# Force the stub even if a URL is set (useful in tests): 1 = on, 0 = use the service.
ANALYSIS_STUB=1

# --- Standing monitoring ---
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to the daily
# sweep. If unset, the sweep route runs unauthenticated (local dev only).
CRON_SECRET=
# HMAC key for signing outgoing webhook alerts (X-PlotProof-Signature header).
ALERT_WEBHOOK_SECRET=

# --- Acoustic ingest ---
# Bearer token the LoRa gateway/network-server webhook sends to /api/acoustic/ingest.
# Unset → ingest runs unauthenticated (local dev only).
ACOUSTIC_INGEST_TOKEN=
