# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets; .env.example is committed)
.env
.env.local
.env*.local

# personal Claude Code overrides (may contain secrets, e.g. MCP server keys)
.claude/settings.local.json
# vendored third-party skills: install locally, don't carry them in the repo
.claude/skills/

# python caches (service/, tooling)
__pycache__/
*.py[cod]

# typescript
*.tsbuildinfo

# supabase local
/supabase/.branches
/supabase/.temp

.vercel
graphify-out/

.vercel
.env*

# Tea training corpora: fetched from the pinned DOIs in models/tea/provenance.json,
# never committed (~1 GB, and CC BY 4.0 does not require redistribution).
models/tea/data/

# Training checkpoints and the versioned ONNX under models/tea/ are build
# outputs; the PUBLISHED artifact in public/models/ is what ships.
models/tea/*.pt
models/tea/*.onnx
models/tea/*.onnx.data

# --- kept local, not published to GitHub -----------------------------------
# The published tree is deliberately what is needed to BUILD AND RUN the site,
# plus README.md, plus the ML pipeline (ml/) and the evidence record (models/)
# that /models is built from. Everything below still exists on the working
# machine and in git history before this commit; it is excluded from the tree a
# visitor clones, not deleted.
#
# Restore any of it with:  git rm --cached -r .gitignore && git add -A
# or simply delete the line that excludes it and `git add` the path.
/DECISIONS.md
/DEPLOY.md
/ML.md
/NEXT-STEPS.md
/PARKED.md
/PROJECT.md
/SCHEMA.md
/BROWSER-SMOKE-TEST.md
/test/
/scripts/
/design-system/
/.mcp.json

# Evaluation logits: large, regenerable, local only.
models/tea/_logits-*.npz
models/tea/_before/
