# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets; .env.example is committed)
.env
.env.local
.env*.local

# personal Claude Code overrides (may contain secrets, e.g. MCP server keys)
.claude/settings.local.json
# vendored third-party skills: install locally, don't carry them in the repo
.claude/skills/

# python caches (service/, tooling)
__pycache__/
*.py[cod]

# typescript
*.tsbuildinfo

# supabase local
/supabase/.branches
/supabase/.temp

.vercel
graphify-out/

.vercel
.env*

# Tea training corpora (~1 GB): fetched from the DOIs in models/tea/provenance.json.
models/tea/data/

# Training outputs; the published model in public/models/ is what ships.
models/tea/*.pt
models/tea/*.onnx
models/tea/*.onnx.data

# Kept local, not published: working notes, tests and scripts. They still exist on this machine;
# delete a line and `git add` the path to publish it.
/DECISIONS.md
/DEPLOY.md
/ML.md
/NEXT-STEPS.md
/PARKED.md
/PROJECT.md
/SCHEMA.md
/BROWSER-SMOKE-TEST.md
